// Type-checks src/, tests/, eval/ and scripts/ together (`npm run check:tests`). It emits nothing, and unused names are allowed.
// `paths` is emptied so that manifold-3d resolves as vitest resolves it.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "types": [
      "node"
    ],
    "paths": {}
  },
  "include": [
    "src/cadfly/**/*.ts",
    "tests/**/*.ts",
    "eval/**/*.ts",
    "eval/**/*.mts",
    "scripts/**/*.ts"
  ]
}
