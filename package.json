{
  "name": "cadfly",
  "version": "0.0.0",
  "private": true,
  "description": "A visual, block-based 3D modeling environment",
  "scripts": {
    "start": "jetlag2d serve",
    "build": "jetlag2d build",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "check:tests": "tsc -p tsconfig.tests.json",
    "eval": "tsx --tsconfig tsconfig.eval.json eval/run.mts",
    "report": "tsx --tsconfig tsconfig.eval.json eval/report.mts",
    "coverage": "vitest run --coverage --reporter=default --reporter=json --outputFile.json=coverage/results.json && tsx --tsconfig tsconfig.tests.json scripts/tests-badge.ts"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.86",
    "jetlag2d": "2.0.0",
    "manifold-3d": "^3.5.4",
    "opentype.js": "^2.0.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.186.0",
    "@vitest/coverage-v8": "^5.1.0",
    "ajv": "^8.20.0",
    "happy-dom": "^21.0.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
